  {
    "type": "group",
    "label": {
      "en": "Basic Settings",
      "nl": "Basisinstellingen"
    },
    "children": [
      {
        "id": "settings_timesync",
        "type": "checkbox",
        "label": {
          "en": "Sync the inverter time to Homey",
          "nl": "Synchroniseer de tijd van de omvormer met Homey"
        },
        "hint": {
          "en": "Sets the clock of the inverter to the time of Homey: right away when you switch this on, and then once every 24 hours. Note: the Time Sync is disabled automatically if the time difference between the inverter and Homey is more than 1 minute at the daily check.",
          "nl": "Zet de klok van de omvormer gelijk aan de tijd van Homey: direct als je dit aanzet en daarna elke 24 uur. Let op: de tijdsynchronisatie wordt automatisch uitgeschakeld als het tijdsverschil tussen de omvormer en Homey bij de dagelijkse controle groter is dan 1 minuut."
        },
        "value": false
      },
      {
        "id": "timesync_status",
        "type": "label",
        "label": {
          "en": "Time sync status",
          "nl": "Status tijdsynchronisatie"
        },
        "value": "not synced yet"
      }
    ]
  },
  {
    "type": "group",
    "label": {
      "en": "Battery Settings",
      "nl": "Batterij-instellingen"
    },
    "children": [
      {
        "id": "settings_energygridchargeenabled",
        "type": "checkbox",
        "label": {
          "en": "Grid Charge Enabled",
          "nl": "Grid Charge Enabled"
        },
        "hint": {
          "en": "Only applies when Time of Use is disabled. When Time of Use is enabled, the setting of each timeslot applies (change it with the flow cards).",
          "nl": "Geldt alleen als Time of Use uit staat. Als Time of Use aan staat geldt de instelling van elk tijdvak (te wijzigen met flowkaarten)."
        },
        "value": false
      },
      {
        "id": "settings_energygenchargeenabled",
        "type": "checkbox",
        "label": {
          "en": "Generator Charge Enabled",
          "nl": "Generator Charge Enabled"
        },
        "hint": {
          "en": "Only applies when Time of Use is disabled. When Time of Use is enabled, the setting of each timeslot applies (change it with the flow cards).",
          "nl": "Geldt alleen als Time of Use uit staat. Als Time of Use aan staat geldt de instelling van elk tijdvak (te wijzigen met flowkaarten)."
        },
        "value": false
      },
      {
        "id": "settings_batteryshutdowncapacity",
        "type": "number",
        "value": 10,
        "min": 0,
        "max": 100,
        "step": 1,
        "units": "%",
        "label": {
          "en": "Battery Shutdown Capacity",
          "nl": "Batterij uitschakelcapaciteit"
        },
        "hint": {
          "en": "Battery capacity (%) at which the inverter shuts down.",
          "nl": "Batterijcapaciteit (%) waarbij de omvormer uitschakelt."
        }
      },
      {
        "id": "settings_batteryrestartcapacity",
        "type": "number",
        "value": 20,
        "min": 0,
        "max": 100,
        "step": 1,
        "units": "%",
        "label": {
          "en": "Battery Restart Capacity",
          "nl": "Batterij herstartcapaciteit"
        },
        "hint": {
          "en": "Battery capacity (%) at which the inverter restarts after a shutdown.",
          "nl": "Batterijcapaciteit (%) waarbij de omvormer na een uitschakeling weer opstart."
        }
      },
      {
        "id": "settings_batterylowcapacity",
        "type": "number",
        "value": 15,
        "min": 0,
        "max": 100,
        "step": 1,
        "units": "%",
        "label": {
          "en": "Battery Low Capacity",
          "nl": "Batterij lage capaciteit"
        },
        "hint": {
          "en": "Battery capacity (%) at which the low battery alarm is given.",
          "nl": "Batterijcapaciteit (%) waarbij het alarm voor lage batterij wordt gegeven."
        }
      },
      {
        "id": "settings_generatorchargestartcapacity",
        "type": "number",
        "value": 50,
        "min": 0,
        "max": 100,
        "step": 1,
        "units": "%",
        "label": {
          "en": "Generator Charging Start Capacity",
          "nl": "Generator laden startcapaciteit"
        },
        "hint": {
          "en": "Battery capacity (%) at which charging from the generator starts.",
          "nl": "Batterijcapaciteit (%) waarbij het laden vanaf de generator start."
        }
      },
      {
        "id": "settings_gridchargestartcapacity",
        "type": "number",
        "value": 50,
        "min": 0,
        "max": 100,
        "step": 1,
        "units": "%",
        "label": {
          "en": "Grid Charging Start Capacity",
          "nl": "Net laden startcapaciteit"
        },
        "hint": {
          "en": "Battery capacity (%) at which charging from the grid starts.",
          "nl": "Batterijcapaciteit (%) waarbij het laden vanaf het net start."
        }
      },
      {
        "id": "settings_generatorchargecurrent",
        "type": "number",
        "value": 40,
        "min": 0,
        "max": 240,
        "step": 1,
        "units": "A",
        "label": {
          "en": "Generator Charge Current",
          "nl": "Generator laadstroom"
        },
        "hint": {
          "en": "Current used to charge the battery from the generator.",
          "nl": "Stroom waarmee de batterij vanaf de generator wordt geladen."
        }
      },
      {
        "id": "settings_gridchargecurrent",
        "type": "number",
        "value": 40,
        "min": 0,
        "max": 240,
        "step": 1,
        "units": "A",
        "label": {
          "en": "Grid Charge Current",
          "nl": "Netlaadstroom"
        },
        "hint": {
          "en": "Current used to charge the battery from the grid.",
          "nl": "Stroom waarmee de batterij vanaf het net wordt geladen."
        }
      },
      {
        "id": "settings_gridsignal",
        "type": "checkbox",
        "label": {
          "en": "Grid Signal",
          "nl": "Grid Signal"
        },
        "hint": {
          "en": "Determines whether the inverter is allowed to draw power from the utility grid to charge or support the battery.",
          "nl": "Bepaalt of de omvormer stroom van het openbare net mag gebruiken om de batterij te laden of te ondersteunen."
        },
        "value": false
      },
      {
        "id": "settings_generatorsignal",
        "type": "checkbox",
        "label": {
          "en": "Generator Signal",
          "nl": "Generator Signal"
        },
        "hint": {
          "en": "Controls the dry-contact relay output (G-start / GS / GV ports) that automatically starts and stops an external backup generator.",
          "nl": "Bestuurt de potentiaalvrije relaisuitgang (G-start / GS / GV-poorten) waarmee een externe noodgenerator automatisch wordt gestart en gestopt."
        },
        "value": false
      }
    ]
  },
