      {
        "id": "settings_timeofuseenabled",
        "type": "checkbox",
        "label": {
          "en": "Time of Use Enabled",
          "nl": "Time of Use Enabled"
        },
        "hint": {
          "en": "When enabled, the settings of the timeslots apply (change them with the flow cards) and not the Solar Sell, Grid Charge and Generator Charge settings below. When disabled, those three settings apply.",
          "nl": "Als dit aan staat gelden de instellingen van de tijdvakken (te wijzigen met flowkaarten) en niet de instellingen Solar Sell, Grid Charge en Generator Charge hieronder. Als dit uit staat gelden die drie instellingen wel."
        },
        "value": false
      },
      {
        "id": "settings_solarsellenabled",
